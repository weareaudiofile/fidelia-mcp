{
  "name": "fidelia",
  "displayName": "Fidelia",
  "version": "1.0.1",
  "description": "Play and explore the music you own in Fidelia, an audiophile music player for Mac.",
  "author": {
    "name": "Audiofile Engineering",
    "url": "https://audiofile.engineering"
  },
  "homepage": "https://audiofile.engineering/fidelia",
  "repository": "https://github.com/weareaudiofile/fidelia-mcp",
  "license": "MIT",
  "keywords": [
    "music",
    "music-player",
    "music-library",
    "audiophile",
    "macos"
  ],
  "icon": "assets/fidelia-icon-512.png",
  "documentationUrl": "https://github.com/weareaudiofile/fidelia-mcp#readme",
  "supportUrl": "https://audiofile.engineering/support",
  "privacyPolicyUrl": "https://audiofile.engineering/privacy",
  "userConfig": {
    "token": {
      "type": "string",
      "title": "Fidelia token",
      "description": "The token from Fidelia ▸ Settings ▸ Agent. A new token there turns this one away.",
      "sensitive": true,
      "required": true
    },
    "port": {
      "type": "number",
      "title": "Fidelia port",
      "description": "The port in Fidelia ▸ Settings ▸ Agent. Leave it unless you changed it there.",
      "default": 38412,
      "min": 1024,
      "max": 49151
    }
  }
}
