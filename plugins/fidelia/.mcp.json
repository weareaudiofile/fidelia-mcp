{
  "mcpServers": {
    "fidelia": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/server/index.js"
      ],
      "env": {
        "AGENT_APP_NAME": "Fidelia",
        "AGENT_PORT": "${user_config.port}",
        "AGENT_TOKEN": "${user_config.token}",
        "AGENT_BUNDLE_ID": "com.audiofile.fidelia",
        "AGENT_LAUNCH_ARGS": "[\"-agent.headless\",\"YES\"]"
      }
    }
  }
}
